{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {"AWS": ["*"]},
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": ["arn:aws:s3:::documents/documents/*/original"],
      "Condition": {"StringEquals": {"s3:ExistingObjectTag/document-state": "retained"}}
    }
  ]
}
