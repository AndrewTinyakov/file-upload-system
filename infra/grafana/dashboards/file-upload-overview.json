          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "name"
      },
      "targets": [
        {
          "expr": "up{job=~\"alertmanager|api|document-worker|image-worker|rabbitmq|rabbitmq-queues\"}",
          "legendFormat": "{{job}} {{instance}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Service health",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "expr": "sum by (method, status) (rate(http_server_requests_seconds_count{job=\"api\",uri=~\"/v1/(assets|upload-sessions)(/.*)?\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "File API request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
