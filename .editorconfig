root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_function-expression-body = disabled
ktlint_standard_function-signature = disabled
ktlint_standard_chain-method-continuation = disabled
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
ij_kotlin_assignment_wrap = off
ij_kotlin_call_parameters_wrap = split_into_lines
ij_kotlin_call_parameters_new_line_after_left_paren = true
ij_kotlin_call_parameters_right_paren_on_new_line = true
ij_kotlin_align_multiline_parameters_in_calls = false
ij_kotlin_continuation_indent_in_argument_lists = false
ij_kotlin_method_parameters_wrap = split_into_lines
ij_kotlin_method_parameters_new_line_after_left_paren = true
ij_kotlin_method_parameters_right_paren_on_new_line = true
ij_kotlin_align_multiline_parameters = false
ij_kotlin_continuation_indent_in_parameter_lists = false
ij_kotlin_method_call_chain_wrap = split_into_lines
ij_kotlin_wrap_first_method_in_call_chain = false
ij_kotlin_continuation_indent_for_chained_calls = true
ij_kotlin_wrap_expression_body_functions = 0
ij_kotlin_wrap_elvis_expressions = 1
ij_kotlin_continuation_indent_in_elvis = false
ij_kotlin_keep_line_breaks = true
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_else_on_new_line = false
ij_continuation_indent_size = 4

[*.java]
ij_java_method_call_chain_wrap = split_into_lines
ij_java_wrap_first_method_in_call_chain = false
ij_java_continuation_indent_for_chained_calls = true
ij_java_keep_line_breaks = true
