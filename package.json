{
  "name": "file-upload-system",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11",
    "npm": ">=11.5.1"
  },
  "scripts": {
    "bench": "node benchmark/src/cli.mjs",
    "format:kotlin": "./api/gradlew -p api ktlintFormat",
    "generate:openapi": "./api/gradlew -p api generateOpenApiDocs && npm run generate:openapi:types",
    "generate:openapi:types": "npm --prefix client run generate:api",
    "dev:client": "npm --prefix client run dev",
    "validate:asyncapi": "asyncapi validate contracts/asyncapi.yaml",
    "generate:asyncapi:kotlin": "node contracts/generate-models.mjs kotlin",
    "generate:asyncapi:go": "node contracts/generate-models.mjs go",
    "test:monitoring": "node scripts/check-monitoring.mjs",
    "test:client": "node --experimental-vm-modules --test client/tests/*.test.mjs",
    "typecheck:client": "npm --prefix client run typecheck",
    "typecheck:system": "tsc -p tests/system/tsconfig.json",
    "test:system": "npm run typecheck:system && node --test --test-concurrency=1 tests/system/*.test.ts"
  },
  "devDependencies": {
    "@asyncapi/cli": "6.1.0",
    "@types/node": "26.6.1",
    "sharp": "0.35.4",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "client"
  ]
}
